# Core Environment
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=vikas_inventory

# JWT Configuration
# Minimum 32 characters required
JWT_SECRET=this_is_a_super_secret_key_that_is_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# Application URLs
ADMIN_PANEL_URL=http://localhost:3001
REACT_NATIVE_WEB_URL=http://localhost:8081
UPLOAD_ROOT=storage/uploads

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_TTL=60000
AUTH_RATE_LIMIT_MAX=5

# Observability Metrics
METRICS_ENABLED=true
METRICS_TOKEN=optional_secret_token_here

# Redis / Queue Infrastructure
QUEUE_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Super Admin Seed Details
SUPER_ADMIN_NAME="System Administrator"
SUPER_ADMIN_EMAIL=admin@vikassales.local
SUPER_ADMIN_PHONE=9999999999
SUPER_ADMIN_PASSWORD=Admin@123

# Default Seed Credentials
MANUFACTURER_ADMIN_EMAIL=manufacturer@vikassales.local
MANUFACTURER_ADMIN_PASSWORD=Password@123

DISTRIBUTOR_ADMIN_EMAIL=distributor@vikassales.local
DISTRIBUTOR_ADMIN_PASSWORD=Password@123

SALESMAN_EMAIL=salesman@vikassales.local
SALESMAN_PASSWORD=Password@123
