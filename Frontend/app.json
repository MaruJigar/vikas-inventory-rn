{
  "expo": {
    "name": "Vikas Marketing",
    "slug": "vikas-inventory",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "runtimeVersion": "1.0.0",
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.vikas.inventory",
      "adaptiveIcon": {
        "backgroundColor": "#111111"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "58885d07-7211-473b-aeda-875736ff4327"
      }
    },
    "owner": "param2607",
    "plugins": [
      "expo-localization",
      "expo-font"
    ]
  }
}
