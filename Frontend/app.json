{
  "expo": {
    "name": "Vikas Marketing",
    "slug": "vikas-inventory",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "runtimeVersion": "1.0.0",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.vikas.inventory",
      "adaptiveIcon": {
        "backgroundColor": "#111111"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "58885d07-7211-473b-aeda-875736ff4327"
      }
    },
    "owner": "param2607",
    "plugins": [
      "expo-localization",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vikas Marketing uses your location to tag shops and find nearby ones."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Vikas Marketing uses the camera to capture a shop's visiting card.",
          "photosPermission": "Vikas Marketing accesses your photos to attach a shop's visiting card."
        }
      ]
    ]
  }
}
